<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suite Professionnelle d'Audit Réseau"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="#009688"/>

        <EditText
            android:id="@+id/etTargetIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP ou URL Cible (ex: 192.168.1.1)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etWordlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dictionnaire de mots de passe / PINs WPS"
            android:inputType="textMultiLine"
            android:lines="4"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/btnLoadDefaultWordlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charger le dictionnaire d'usine"
            android:backgroundTint="#757575"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnBruteForce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Lancer Brute Force SSH"
            android:backgroundTint="#D32F2F"/>

        <Button
            android:id="@+id/btnInternetAudit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Audit En-têtes Internet (cURL / WAF)"
            android:backgroundTint="#F57C00"/>

        <Button
            android:id="@+id/btnWifiWps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Audit Vulnérabilité Wi-Fi (WPS/BSSID)"
            android:backgroundTint="#388E3C"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnExportReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exporter le rapport d'audit (.txt)"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Console de sortie d'audit :"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvConsoleLog"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#1E1E1E"
            android:textColor="#00FF00"
            android:padding="10dp"
            android:text="[+] Système d'audit prêt. Chargez un dictionnaire pour commencer."
            android:fontFamily="monospace"
            android:scrollbars="vertical"/>
    </LinearLayout>
</ScrollView>
